# n8n/.env is created by ./setup.sh with random values. It is gitignored.
# Never commit it, and keep a copy of N8N_ENCRYPTION_KEY in a password manager.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
N8N_ENCRYPTION_KEY=

# Where ./backup.sh writes nightly backups (outside the n8n data volumes).
BACKUP_DIR=
