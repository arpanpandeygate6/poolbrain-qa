    {
      "id": "c2b2c3d4-0001-4000-8000-000000000019",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
        0
      ],
      "parameters": {
        "jsCode": "// What was reversed, in words for the S6 reply.\nconst u = $('Undo').first().json;\nconst t = $('Pick transition').isExecuted ? $('Pick transition').first().json : {};\nconst pr = $('Find the PR').isExecuted ? $('Find the PR').first().json : {};\nlet what;\nif (u.action === 'approve') what = `The questions on ${u.jira_key} were marked withdrawn in a comment`;\nelse {\n  what = `${u.jira_key} marked as undone in Jira${t.transition_name ? ` (moved to ${t.transition_name})` : ''}`;\n  if (u.action === 'flaky') what += pr.pr ? `, and its quarantine PR was labelled undo-requested` : '';\n}\nreturn [{ json: { what } }];\n"
      }
    }
