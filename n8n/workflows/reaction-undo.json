      "parameters": {
        "jsCode": "const res = $input.first().json;\nif (![200, 201, 204].includes(res.statusCode)) throw new Error(`Jira refused the undo step for ${$('Undo').first().json.jira_key} (${res.statusCode}): ${JSON.stringify(res.body ?? {}).slice(0, 200)}`);\nreturn [{ json: { ok: true } }];\n"
      }
    },
