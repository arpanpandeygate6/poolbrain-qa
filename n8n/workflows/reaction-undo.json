    {
      "id": "c2b2c3d4-0001-4000-8000-000000000005",
      "name": "Pick transition",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        -200
      ],
      "parameters": {
        "jsCode": "// The first available transition whose name is in close_names, in that order.\n// None available: the ticket keeps its status; the label and comment still record the undo.\nconst names = $('Settings').first().json.close_names.split(',').map((n) => n.trim().toLowerCase());\nconst res = $input.first().json;\nif (res.statusCode !== 200) throw new Error(`Jira didn't list the transitions of ${$('Undo').first().json.jira_key} (${res.statusCode})`);\nconst transitions = res.body.transitions ?? [];\nconst pick = names.map((n) => transitions.find((t) => (t.name ?? '').toLowerCase() === n || (t.to?.name ?? '').toLowerCase() === n))\n  .find(Boolean);\nreturn [{ json: { transition_id: pick ? pick.id : '', transition_name: pick ? (pick.to?.name || pick.name) : '' } }];\n"
      }
    },
