    {
      "id": "c2b2c3d4-0001-4000-8000-000000000013",
      "name": "Find the PR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        -300
      ],
      "parameters": {
        "jsCode": "// A 🔁's quarantine PR, if it is open: label it undo-requested.\nconst res = $input.first().json;\nconst pulls = res.statusCode === 200 && Array.isArray(res.body) ? res.body : [];\nreturn [{ json: { pr: pulls[0] ? pulls[0].number : 0, pr_url: pulls[0] ? pulls[0].html_url : '' } }];\n"
      }
