    {
      "id": "c2b2c3d4-0001-4000-8000-000000000016",
      "name": "Undo comment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        0
      ],
      "parameters": {
        "jsCode": "// The undo, recorded as a comment (nothing is deleted).\n\n// Atlassian Document Format helpers: a paragraph of text and links.\nconst text = (t) => ({ type: 'text', text: t });\nconst linkTo = (label, url) => ({ type: 'text', text: label, marks: [{ type: 'link', attrs: { href: url } }] });\nconst para = (...parts) => ({ type: 'paragraph', content: parts.map((x) => (typeof x === 'string' ? text(x) : x)) });\nconst links = (items) => para(...items.filter((l) => l.url).flatMap((l, i) => (i ? [' · ', linkTo(l.label, l.url)] : [linkTo(l.label, l.url)])));\n\nconst u = $('Undo').first().json;\nconst message = u.action === 'approve'\n  ? `These clarification questions were withdrawn by ${u.actor_name} via Slack. Please ignore them. — Filed via QA bot`\n  : `Undone by ${u.actor_name} via Slack within 24 hours of filing. Nothing was deleted. — Filed via QA bot`;\nreturn [{ json: { body: { type: 'doc', version: 1, content: [para(message)] } } }];\n"
      }
    },
