        "jsCode": "// Only runs the gate allows (AI work on); the rest are asked about again later.\nconst toPost = $('Check questions').all().filter((r) => r.json.state === 'to-post');\nconst repo = $('Settings').first().json.repo;\nreturn $input.all().flatMap((answer, i) => (answer.json.allowed === true\n  ? [{ json: { ...toPost[i].json, repo, name: 'run-outcome' } }] : []));\n"
