        "jsCode": "// Report invalid files and posts Slack didn't take through W0 (the invalid run\n// is already saved, so it is reported once).\nconst invalid = $('Check questions').all().filter((r) => r.json.state === 'invalid');\nconst failed = ($('Post').isExecuted ? $('Post').all() : []).filter((p) => !p.json.posted && !p.json.preview);\nif (invalid.length) throw new Error(`questions file of draft-cases run ${invalid[0].json.run_id} is not valid: ${invalid[0].json.problem}`);\nif (failed.length) throw new Error(`questions not posted: ${failed[0].json.error}`);\nreturn [{ json: { ok: true } }];\n"
      },
      "executeOnce": true
    }
