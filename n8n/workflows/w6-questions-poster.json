      "name": "New runs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "jsCode": "// Finished draft-cases runs of the last 2 days not handled yet. A run whose\n// posting the gate held back is asked about again once its wait is over.\nconst list = (v) => (Array.isArray(v) ? v : JSON.parse(v || '[]'));\nconst handled = new Set(list($('Known runs').first().json.handled));\nconst waiting = new Set(list($('Known runs').first().json.waiting));\nconst repo = $('Settings').first().json.repo;\nreturn ($('draft-cases runs').first().json.workflow_runs ?? [])\n  .filter((r) => r.status === 'completed' && r.conclusion === 'success')\n  .filter((r) => !handled.has(String(r.id)) && !waiting.has(String(r.id)))\n  .map((r) => ({ json: { repo, run_id: String(r.id), name: 'questions' } }));\n"
      }
    },
