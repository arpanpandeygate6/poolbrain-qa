      "parameters": {
        "jsCode": "return $('Rows to save').all().filter((r) => ['posted', 'preview'].includes(r.json.state)).map((r) => ({\n  json: { actor: 'n8n:w6-questions-poster', actor_type: 'n8n', action: `questions-${r.json.state}`,\n    target: r.json.ticket, link: `https://github.com/${$('Settings').first().json.repo}/actions/runs/${r.json.run_id}` },\n}));\n"
      },
      "executeOnce": true
    },
