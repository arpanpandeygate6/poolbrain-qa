    {
      "id": "d6b2c3d4-0001-4000-8000-000000000013",
      "name": "Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        -200
      ],
      "parameters": {
        "jsCode": "// S8 (EXPERIENCE.md M8), top-level, kind `questions`. Legend words copied from\n// contracts/vocabulary.json (reactions approve and undo).\nconst LEGEND = 'React: ✅ Approve (send to Jira) · ↩️ Undo within 24 h';\nconst jira = $('Settings').first().json.jira_url;\nconst allowed = $('Allowed runs').all();\nreturn $input.all().map((outcome, i) => {\n  const r = allowed[i].json;\n  const pr = outcome.json.found ? outcome.json.data.pr_url : '';\n  const links = [];\n  if (pr) links.push({ label: 'PR 1', url: pr });\n  links.push({ label: `Jira ${r.ticket}`, url: `${jira}/browse/${r.ticket}` });\n  return { json: {\n    run_id: r.run_id, ticket: r.ticket,\n    kind: '', header: `Questions about ${r.ticket} before testing`,\n    body: ['The agent found unclear acceptance criteria:',\n      ...[...r.questions].sort((a, b) => a.number - b.number).map((q) => `${q.number}. ${q.question}`)].join('\\n'),\n    todo: `react ✅ to add these to ${r.ticket} as a comment naming you. Nothing goes to Jira without ✅.`,\n    todo_label: '', links, legend: LEGEND, thread_ts: '',\n  } };\n});\n"
      }
