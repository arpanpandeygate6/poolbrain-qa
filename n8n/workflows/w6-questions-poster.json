    {
      "id": "d6b2c3d4-0001-4000-8000-000000000008",
      "name": "Check questions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "// The questions file's contract (contracts/questions.schema.json), checked here\n// because n8n can't run the Python validator. scripts/tests/test_n8n_workflows.py\n// checks that this copy agrees with it.\nfunction problemOf(q) {\n  if (!q || typeof q !== 'object' || Array.isArray(q)) return 'not a JSON object';\n  if (Object.keys(q)[0] !== 'schema_version') return \"'schema_version' must be the first field\";\n  if (q.schema_version !== 1) return `unknown schema_version ${JSON.stringify(q.schema_version)}`;\n  const extra = Object.keys(q).filter((k) => !['schema_version', 'ticket', 'questions'].includes(k));\n  if (extra.length) return `unexpected field ${extra[0]}`;\n  if (typeof q.ticket !== 'string' || !/^[A-Z][A-Z0-9]+-[0-9]+$/.test(q.ticket)) return 'ticket must be a Jira key';\n  if (!Array.isArray(q.questions) || q.questions.length > 10) return 'questions must be a list of at most 10';\n  for (const [i, item] of q.questions.entries()) {\n    if (!item || typeof item !== 'object' || Array.isArray(item)) return `question ${i + 1} is not an object`;\n    const keys = Object.keys(item);\n    if (keys.some((k) => !['number', 'question', 'about'].includes(k))) return `question ${i + 1} has an unexpected field`;\n    if (!Number.isInteger(item.number) || item.number < 1) return `question ${i + 1}: number must be 1 or more`;\n    if (typeof item.question !== 'string' || item.question.length < 10 || item.question.length > 500) return `question ${i + 1}: question must be 10 to 500 characters`;\n    if (typeof item.about !== 'string' || item.about.length > 200) return `question ${i + 1}: about must be at most 200 characters`;\n  }\n  return '';\n}\n\nconst runs = $('New runs').all();\nreturn $input.all().map((read, i) => {\n  const run = runs[i].json;\n  if (!read.json.found) return { json: { run_id: run.run_id, state: 'none', ticket: '' } };\n  const problem = problemOf(read.json.data);\n  if (problem) return { json: { run_id: run.run_id, state: 'invalid', ticket: '', problem } };\n  const q = read.json.data;\n  return { json: { run_id: run.run_id, state: q.questions.length ? 'to-post' : 'none', ticket: q.ticket, questions: q.questions } };\n});\n"
      }
