    {
      "id": "d6b2c3d4-0001-4000-8000-000000000015",
      "name": "Rows to save",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        100
      ],
      "parameters": {
        "jsCode": "// Every handled run gets a row: posted or preview (with its mapping when it\n// really posted), none, or invalid. A post Slack didn't take gets no row, so it\n// is tried again; it fails the run below.\nconst messages = $('Message').isExecuted ? $('Message').all().map((m) => m.json) : [];\nconst results = $('Post').isExecuted ? $('Post').all().map((p) => p.json) : [];\nconst posted = Object.fromEntries(messages.map((m, i) => [m.run_id, results[i]]));\nreturn $('Check questions').all().flatMap((r) => {\n  const c = r.json;\n  if (c.state !== 'to-post') return [{ json: { run_id: c.run_id, ticket: c.ticket, state: c.state, channel: '', ts: '' } }];\n  const p = posted[c.run_id];\n  if (!p || !(p.posted || p.preview)) return [];\n  return [{ json: { run_id: c.run_id, ticket: c.ticket, state: p.posted ? 'posted' : 'preview', channel: p.channel ?? '', ts: p.ts ?? '' } }];\n});\n"
      }
    },
    {
      "id": "d6b2c3d4-0001-4000-8000-000000000016",
      "name": "Save",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1600,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- The run is handled; a posted message is mapped (kind questions, ticket, run);\n-- the gate's posting request is done.\nWITH handled AS (\n  INSERT INTO audit.w6_runs (run_id, ticket, state) VALUES ($1::bigint, $2, $3)\n  ON CONFLICT (run_id) DO NOTHING\n  RETURNING run_id\n), mapped AS (\n  INSERT INTO audit.message_map (channel, ts, kind, ticket, source_run_id, thread_ts)\n  SELECT $4, $5, 'questions', $2, $1::bigint, $5 WHERE $5 <> ''\n  ON CONFLICT (channel, ts) DO NOTHING\n  RETURNING id\n), dequeued AS (\n  UPDATE audit.deferred_requests SET done_at = now()\n  WHERE action = 'questions-post' AND target = $1 AND done_at IS NULL AND $3 IN ('posted', 'preview')\n  RETURNING id\n)\nSELECT (SELECT count(*) FROM handled) AS handled;",
        "options": {
          "queryReplacement": "={{ [$json.run_id, $json.ticket, $json.state, $json.channel, $json.ts] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "auditPostgres001",
          "name": "Audit log (Postgres)"
        }
      }
    },
    {
      "id": "d6b2c3d4-0001-4000-8000-000000000017",
