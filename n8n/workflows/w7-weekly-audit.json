{
  "id": "w7WeeklyAudit001",
  "name": "W7 Weekly audit log",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "w0ErrorHandler1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  },
  "nodes": [
    {
      "id": "d7b2c3d4-0001-4000-8000-000000000001",
      "name": "Every Monday 04:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
