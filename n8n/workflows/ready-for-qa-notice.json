    {
      "id": "a7b2c3d4-0001-4000-8000-000000000012",
      "name": "Audit fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        -200
      ],
      "parameters": {
        "jsCode": "// One audit entry per notice, with the ticket key and the Slack link (the\n// Jira link while Slack is not set up). A notice Slack didn't take gets no\n// entry, so it is tried again on the next poll.\nconst notices = $('Notices to send').all();\nreturn $input.all()\n  .map((r, i) => ({ r: r.json, notice: notices[i].json }))\n  .filter(({ r }) => r.posted || r.preview)\n  .map(({ r, notice }) => ({\n    json: {\n      actor: 'n8n:ready-notice',\n      actor_type: 'n8n',\n      action: r.posted ? 'ready-notice-posted' : 'ready-notice-preview',\n      target: notice.key,\n      link: r.link || notice.jira,\n    },\n  }));\n"
      }
    },
