    {
      "id": "a7b2c3d4-0001-4000-8000-000000000004",
      "name": "Get checkpoint",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Look back to the last fully successful poll, plus 10 minutes for Jira's\n-- search to catch up, as minutes for Jira's relative dates (which ignore\n-- time zones). The first run starts from now, so old tickets aren't\n-- announced. Tickets already noticed are skipped later, so overlap is safe.\nSELECT ceil(extract(epoch FROM now() - (coalesce(\n         (SELECT value FROM audit.checkpoints WHERE name = 'ready-notice'),\n         now()) - interval '10 minutes')) / 60)::int AS look_back_minutes,\n       now() AS polled_at;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "auditPostgres001",
          "name": "Audit log (Postgres)"
        }
      }
    },
    {
      "id": "a7b2c3d4-0001-4000-8000-000000000005",
      "name": "Find tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Settings').first().json.jira_url }}/rest/api/3/search/jql",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "jql",
              "value": "=project = \"{{ $('Settings').first().json.project }}\" AND status CHANGED TO \"{{ $('Settings').first().json.ready_status }}\" AFTER -{{ $json.look_back_minutes }}m ORDER BY updated ASC"
            },
            {
              "name": "fields",
              "value": "summary"
            },
            {
              "name": "maxResults",
              "value": "100"
            }
          ]
        },
        "options": {
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "nextPageToken",
                    "value": "={{ $response.body.nextPageToken }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.nextPageToken }}",
              "limitPagesFetched": true,
              "maxRequests": 10
            }
          }
        }
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "3AkYlHarhuAfIA7s",
          "name": "Jira (QA relay)"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "a7b2c3d4-0001-4000-8000-000000000006",
      "name": "Save checkpoint",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2640,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit.checkpoints (name, value) VALUES ('ready-notice', $1)\nON CONFLICT (name) DO UPDATE SET value = excluded.value\nRETURNING value;",
        "options": {
          "queryReplacement": "={{ $('Get checkpoint').first().json.polled_at }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "auditPostgres001",
          "name": "Audit log (Postgres)"
        }
      },
      "executeOnce": true
    },
    {
      "id": "a7b2c3d4-0001-4000-8000-000000000007",
      "name": "Already noticed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Each ticket gets at most one notice. A preview counts, so turning Slack on\n-- later doesn't re-announce old tickets.\nSELECT coalesce(json_agg(DISTINCT target), '[]') AS keys\nFROM audit.audit_log\nWHERE action IN ('ready-notice-posted', 'ready-notice-preview');",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "auditPostgres001",
          "name": "Audit log (Postgres)"
        }
      },
      "executeOnce": true
    },
