    {
      "id": "a7b2c3d4-0001-4000-8000-000000000014",
      "name": "Check for failures",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        0
      ],
      "parameters": {
        "jsCode": "// If Slack didn't take a notice, fail so W0 alerts. The ticket has no audit\n// entry, so the next poll (which looks back a day) tries it again.\nconst notices = $('Notices to send').all();\nconst failed = $input.all()\n  .map((r, i) => ({ r: r.json, key: notices[i].json.key }))\n  .filter(({ r }) => !r.posted && !r.preview);\nif (failed.length) {\n  throw new Error(`Slack did not take the notice for ${failed.map((f) => f.key).join(', ')}: ${failed[0].r.error}`);\n}\nreturn [{ json: { notices: $input.all().length } }];\n"
      }
    }
