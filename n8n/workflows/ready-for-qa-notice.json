    {
      "id": "a7b2c3d4-0001-4000-8000-000000000010",
      "name": "Notices to send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "// One S-notice per ticket that newly moved to the ready status: header,\n// ticket title and the latest UAT result. Only the key and title are read\n// from Jira, never the description or acceptance criteria.\n\n// Status words, copied from contracts/vocabulary.json (test_status).\n// scripts/tests/test_n8n_workflows.py checks that this copy still matches.\nconst RESULT = { success: 'PASSED', failure: 'FAILED', timed_out: 'FAILED' };\n\nconst settings = $('Settings').first().json;\nconst seen = new Set($('Already noticed').first().json.keys ?? []);\nconst issues = $('Find tickets').all().flatMap((page) => page.json.issues ?? []);\n\n// \"04 Oct 02:30 IST\"\nfunction ist(iso) {\n  const parts = Object.fromEntries(\n    new Intl.DateTimeFormat('en-GB', {\n      timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23',\n    }).formatToParts(new Date(iso)).map((p) => [p.type, p.value]),\n  );\n  return `${parts.day} ${parts.month} ${parts.hour}:${parts.minute} IST`;\n}\n\nconst escape = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\n// A workflow that doesn't exist yet answers 404; its runs are then empty.\nfunction runsOf(nodeName) {\n  const runs = $(nodeName).first().json.workflow_runs;\n  return Array.isArray(runs) ? runs : [];\n}\nconst latest = [...runsOf('nightly runs'), ...runsOf('uat-pr runs')]\n  .filter((r) => r.status === 'completed' && RESULT[r.conclusion])\n  .sort((a, b) => (b.run_started_at ?? b.created_at).localeCompare(a.run_started_at ?? a.created_at))[0];\n\nconst result = latest\n  ? `Latest UAT result: *${RESULT[latest.conclusion]}* (${latest.path.split('/').pop().replace(/\\.ya?ml.*$/, '')}, `\n    + `${ist(latest.run_started_at ?? latest.created_at)}).`\n  : 'No UAT run yet.';\n\nreturn issues\n  .filter((issue) => issue.key && !seen.has(issue.key))\n  .map((issue) => {\n    const jira = `${settings.jira_url}/browse/${issue.key}`;\n    const links = [{ label: 'Jira', url: jira }];\n    if (latest) links.push({ label: 'Latest run', url: latest.html_url });\n    return {\n      json: {\n        kind: 'info',\n        header: `${issue.key} is ready for QA`,\n        body: `*${escape(issue.fields?.summary ?? '(no title)')}*\\n${result}`,\n        todo: '',\n        links,\n        thread_ts: '',\n        key: issue.key,\n        jira,\n      },\n    };\n  });\n"
      },
      "alwaysOutputData": true
    },
