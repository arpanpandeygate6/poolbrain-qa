{
  "id": "runRecorder00001",
  "name": "Audit: record GitHub runs",
  "active": false,
  "nodes": [
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000001",
      "name": "Every 10 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000009",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        160
      ],
      "parameters": {}
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000002",
      "name": "Get checkpoint",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT to_char((coalesce((SELECT value FROM audit.checkpoints WHERE name = 'run-recorder'),\n                         now() - interval '7 days') - interval '1 day') AT TIME ZONE 'UTC',\n               'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"') AS look_back_from,\n       now() AS polled_at;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "auditPostgres001",
          "name": "Audit log (Postgres)"
        }
      }
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000003",
      "name": "Completed runs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/arpanpandeygate6/poolbrain-qa/actions/runs?status=completed&per_page=100&created=%3E%3D{{ $json.look_back_from }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubAppApi",
        "options": {}
      },
      "credentials": {
        "githubAppApi": {
          "id": "rtFV51PZnrrirWP0",
          "name": "qa-relay"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000004",
      "name": "Runs to record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "jsCode": "// Workflows recorded in the audit log, and their actor type (AD-12).\nconst RECORDED = {\n  'draft-cases': 'agent',\n  'generate-tests': 'agent',\n  'triage': 'agent',\n  'quarantine': 'agent',\n  'nightly': 'ci',\n  'smoke': 'ci',\n  'uat-pr': 'ci',\n  'mock-tests': 'ci', // stand-in for nightly while there is no UAT access\n};\n\nconst runs = $input.first().json.workflow_runs ?? [];\nreturn runs\n  .map((run) => ({ run, workflow: (run.path ?? '').split('/').pop().replace(/\\.ya?ml(@.*)?$/, '') }))\n  .filter(({ run, workflow }) => RECORDED[workflow] && run.status === 'completed')\n  .map(({ run, workflow }) => ({\n    json: {\n      actor: `${RECORDED[workflow]}:${workflow}`,\n      actor_type: RECORDED[workflow],\n      action: `run-${run.conclusion ?? 'unknown'}`,\n      target: `${workflow} #${run.run_number} on ${run.head_branch ?? '?'} (${run.head_sha.slice(0, 7)})`,\n      link: run.html_url,\n    },\n  }));"
      }
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000005",
      "name": "Write audit entries",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "auditWriteEntry1",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "actor": "={{ $json.actor }}",
            "actor_type": "={{ $json.actor_type }}",
            "action": "={{ $json.action }}",
            "target": "={{ $json.target }}",
            "link": "={{ $json.link }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "actor",
              "displayName": "actor",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            },
            {
              "id": "actor_type",
              "displayName": "actor_type",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            },
            {
              "id": "action",
              "displayName": "action",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            },
            {
              "id": "target",
              "displayName": "target",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            },
            {
              "id": "link",
              "displayName": "link",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      }
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000006",
      "name": "Save checkpoint",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit.checkpoints (name, value) VALUES ('run-recorder', $1)\nON CONFLICT (name) DO UPDATE SET value = excluded.value;",
        "options": {
          "queryReplacement": "={{ $('Get checkpoint').first().json.polled_at }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "auditPostgres001",
          "name": "Audit log (Postgres)"
        }
      },
      "executeOnce": true
    }
  ],
  "connections": {
    "Every 10 minutes": {
      "main": [
        [
          {
            "node": "Get checkpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now": {
      "main": [
        [
          {
            "node": "Get checkpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get checkpoint": {
      "main": [
        [
          {
            "node": "Completed runs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Completed runs": {
      "main": [
        [
          {
            "node": "Runs to record",
            "type": "main",
            "index": 0
          },
          {
            "node": "Save checkpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Runs to record": {
      "main": [
        [
          {
            "node": "Write audit entries",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  }
}