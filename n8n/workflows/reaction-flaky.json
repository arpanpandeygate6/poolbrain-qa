    {
      "id": "b1b2c3d4-0001-4000-8000-000000000011",
      "name": "Build task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        -100
      ],
      "parameters": {
        "jsCode": "// The S18 owner ticket (EXPERIENCE.md M17), and the quarantine request it backs.\n\n// Atlassian Document Format helpers: a paragraph of text and links.\nconst text = (t) => ({ type: 'text', text: t });\nconst linkTo = (label, url) => ({ type: 'text', text: label, marks: [{ type: 'link', attrs: { href: url } }] });\nconst para = (...parts) => ({ type: 'paragraph', content: parts.map((x) => (typeof x === 'string' ? text(x) : x)) });\nconst links = (items) => para(...items.filter((l) => l.url).flatMap((l, i) => (i ? [' · ', linkTo(l.label, l.url)] : [linkTo(l.label, l.url)])));\n\nconst r = $('Reaction').first().json;\nconst s = $('Settings').first().json;\nconst owner = $('Check owner').first().json.owner;\n// Rerun evidence from the night's failure-list (history and retry pass).\nconst list = $('Failure list').first().json;\nconst failure = list.found ? (list.data.failures ?? []).find((f) => f.test_id === r.test_id) : null;\nconst nights = failure?.history ?? [];\nconst failed = nights.filter((n) => ['failed', 'passed-on-retry'].includes(n.result)).length;\nconst parts = [];\nif (nights.length) parts.push(`Failed ${failed} of the last ${nights.length} nights`);\nif (failure?.flaky_candidate) parts.push('passed on retry');\nconst evidence = parts.length ? `${parts.join(', ')}.` : 'No retry pass or earlier failure recorded; marked flaky by a QA member.';\nconst deadline = new Date(Date.now() + 14 * 86400000).toISOString().slice(0, 10);\nconst shown = new Date(`${deadline}T12:00:00Z`).toLocaleString('en-US', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });\nlet listed = {};\ntry { listed = JSON.parse(s.account_map || '{}'); } catch { listed = {}; }\nconst users = $('Jira user').first().json.body;\nconst accountId = listed[r.actor_email.toLowerCase()] || (Array.isArray(users) && users[0] ? users[0].accountId : '');\nconst runUrl = `https://github.com/${r.repo}/actions/runs/${r.nightly_run_id}`;\nconst thread = $('Slack link').first().json.permalink || '';\nconst description = { type: 'doc', version: 1, content: [\n  para(`Filed via QA bot, by ${r.actor_name} from Slack.`),\n  para(`Owner: ${owner} (from the flow inventory). Deadline: ${shown} (2 weeks).`),\n  para(`Marked flaky by ${r.actor_name}. ${evidence}`),\n  para('A quarantine PR will be opened; the test keeps gating until QA merges it.'),\n  para('Test: ', { type: 'text', text: r.test_id, marks: [{ type: 'code' }] }),\n  links([{ label: 'Nightly run', url: runUrl }, { label: 'Slack thread', url: thread }]),\n] };\nconst fields = { project: { key: s.project }, issuetype: { name: s.issue_type }, summary: `Flaky test: ${r.test_id}`.slice(0, 250),\n  labels: [s.label], duedate: deadline, description };\nreturn [{ json: { account_id: accountId, owner, deadline, evidence: evidence.slice(0, 300), thread, runUrl,\n  with_reporter: accountId ? { ...fields, reporter: { id: accountId } } : fields, without_reporter: fields } }];\n"
      }
    },
