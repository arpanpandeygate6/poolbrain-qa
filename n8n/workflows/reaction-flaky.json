      "typeVersion": 2,
      "position": [
        3400,
        -100
      ],
      "parameters": {
        "jsCode": "// Read the bug back: is the member its Reporter?\nconst res = $input.first().json;\nif (res.statusCode !== 200) throw new Error(`Jira didn't return the new ticket (${res.statusCode})`);\nconst accountId = $('Build task').first().json.account_id;\nreturn [{ json: { key: res.body.key, reporter_ok: Boolean(accountId) && res.body.fields?.reporter?.accountId === accountId } }];\n"
      }
    },
