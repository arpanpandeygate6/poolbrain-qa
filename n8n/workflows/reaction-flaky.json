    {
      "id": "b1b2c3d4-0001-4000-8000-000000000020",
      "name": "Filed-by comment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3800,
        0
      ],
      "parameters": {
        "jsCode": "// S20: the Reporter couldn't be set, so a comment names who filed it.\n\n// Atlassian Document Format helpers: a paragraph of text and links.\nconst text = (t) => ({ type: 'text', text: t });\nconst linkTo = (label, url) => ({ type: 'text', text: label, marks: [{ type: 'link', attrs: { href: url } }] });\nconst para = (...parts) => ({ type: 'paragraph', content: parts.map((x) => (typeof x === 'string' ? text(x) : x)) });\nconst links = (items) => para(...items.filter((l) => l.url).flatMap((l, i) => (i ? [' · ', linkTo(l.label, l.url)] : [linkTo(l.label, l.url)])));\n\nconst r = $('Reaction').first().json;\nreturn [{ json: { body: { type: 'doc', version: 1, content: [\n  para(`Filed by ${r.actor_name} (${r.actor_email}) via Slack. Jira didn't accept them as Reporter. Filed via QA bot.`)] } } }];\n"
      }
    },
