      "id": "b1b2c3d4-0001-4000-8000-000000000005",
      "name": "Check owner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "jsCode": "// The test's owner from flows/inventory.yaml on main, and whether it is already\n// quarantined. Read as text (the files' fixed format), without a YAML library.\nconst r = $('Reaction').first().json;\nconst decode = (res) => (res.statusCode === 200 && res.body?.content ? atob(res.body.content.replace(/\\s/g, '')) : '');\nconst inventory = decode($('Inventory').first().json);\nconst quarantine = decode($('Quarantine list').first().json);\nif (!inventory) throw new Error('flows/inventory.yaml could not be read from main');\nconst unquote = (v) => { v = v.trim(); try { return v.startsWith('\"') ? JSON.parse(v) : v.replace(/^'(.*)'$/, '$1'); } catch { return v; } };\nconst listed = [...quarantine.matchAll(/^\\s*-?\\s*test_id:\\s*(.+)$/gm)].map((m) => unquote(m[1]));\nif (listed.includes(r.test_id)) return [{ json: { stop: 'already-quarantined' } }];\nconst block = inventory.split(/^\\s*- id:\\s*/m).slice(1).find((b) => unquote(b.split('\\n')[0]) === r.flow_id) ?? '';\nconst owner = unquote((block.match(/^\\s+owner:\\s*(.+)$/m) ?? [])[1] ?? '');\nif (!owner || /^(tbd|todo|none|-)$/i.test(owner)) return [{ json: { stop: 'owner-missing' } }];\nreturn [{ json: { stop: '', owner } }];\n"
      }
    },
