    {
      "id": "e3b2c3d4-0001-4000-8000-000000000018",
      "name": "To check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        -100
      ],
      "parameters": {
        "jsCode": "// Messages with no live decision yet: read their reactions.\nconst list = (v) => (Array.isArray(v) ? v : JSON.parse(v || '[]'));\nreturn list($('Load messages').first().json.messages).filter((m) => !m.decision).map((m) => ({ json: m }));\n"
      }
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000019",
      "name": "Reactions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        -100
      ],
      "parameters": {
        "method": "GET",
        "url": "https://slack.com/api/reactions.get",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "channel",
              "value": "={{ $json.channel }}"
            },
            {
              "name": "timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "full",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "slackApi": {
          "id": "slackQaBot000001",
          "name": "QA Bot (Slack)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000020",
      "name": "First valid reaction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        -100
      ],
      "parameters": {
        "jsCode": "// The first reaction Slack lists that is valid for the message kind and was\n// added by a QA group member (EXPERIENCE.md, reaction legend). Other emoji,\n// reactions from anyone else, and any later reactions are ignored; ↩️ is\n// handled by the undo step (Story 6.8).\n// Slack names copied from contracts/vocabulary.json (reactions[*].slack_names);\n// scripts/tests/test_n8n_workflows.py checks the copy.\nconst REACTIONS = {\"bug\": {\"names\": [\"lady_beetle\", \"ladybug\", \"beetle\"], \"valid_on\": [\"failure\"]}, \"flaky\": {\"names\": [\"repeat\"], \"valid_on\": [\"failure\"]}, \"environment\": {\"names\": [\"lightning\", \"lightning_cloud\", \"cloud_with_lightning\"], \"valid_on\": [\"failure\"]}, \"ignore\": {\"names\": [\"see_no_evil\"], \"valid_on\": [\"failure\"]}, \"approve\": {\"names\": [\"white_check_mark\"], \"valid_on\": [\"questions\"]}, \"undo\": {\"names\": [\"leftwards_arrow_with_hook\"], \"valid_on\": [\"failure\", \"questions\"]}};\nconst members = new Set($('QA members').first().json.members);\nconst messages = $('To check').all();\nconst actionOf = (name, kind) => Object.entries(REACTIONS)\n  .find(([action, r]) => action !== 'undo' && r.valid_on.includes(kind) && r.names.includes(name.split('::')[0]))?.[0];\nreturn $input.all().flatMap((page, i) => {\n  const m = messages[i].json;\n  for (const reaction of page.json.message?.reactions ?? []) {\n    const action = actionOf(reaction.name ?? '', m.kind);\n    const user = action ? (reaction.users ?? []).find((u) => members.has(u)) : undefined;\n    if (user) return [{ json: { ...m, action, actor_id: user } }];\n  }\n  return [];\n});\n"
      }
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000021",
      "name": "Who reacted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        -100
      ],
      "parameters": {
        "method": "GET",
        "url": "https://slack.com/api/users.info",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "user",
              "value": "={{ $json.actor_id }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "slackApi": {
          "id": "slackQaBot000001",
          "name": "QA Bot (Slack)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000022",
      "name": "Decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        -100
      ],
      "parameters": {
        "jsCode": "// Who reacted, and what happens. This part handles 🌩️ Environment and 🙈\n// Ignore; 🐞 Bug, 🔁 Flaky and ✅ Approve are added with Jira (Stories 6.4,\n// 6.6, 6.7) and stay unhandled until then.\nconst found = $('First valid reaction').all();\nreturn $input.all().flatMap((user, i) => {\n  const m = found[i].json;\n  if (!['environment', 'ignore'].includes(m.action)) return [];\n  const profile = user.json.user?.profile ?? {};\n  const email = profile.email || `${m.actor_id}@slack.invalid`;\n  const name = profile.display_name || profile.real_name || user.json.user?.name || m.actor_id;\n  return [{ json: { ...m, actor_email: email, actor_name: name,\n    state: m.action === 'ignore' ? 'waiting-for-reason' : 'handled' } }];\n});\n"
      }
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000023",
      "name": "Record decision",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2600,
        -100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- One live decision per message; a second reaction can't add another. Always\n-- one row back (the new id, or null), so rows stay in line with decisions.\nWITH saved AS (\n  INSERT INTO audit.reaction_decisions (map_id, action, state, actor_id, actor_email, actor_name, handled_at)\n  VALUES ($1::bigint, $2, $3, $4, $5, $6, CASE WHEN $3 = 'handled' THEN now() END)\n  ON CONFLICT (map_id) WHERE undone_at IS NULL DO NOTHING\n  RETURNING id\n)\nSELECT (SELECT id FROM saved) AS id;",
        "options": {
          "queryReplacement": "={{ [$json.map_id, $json.action, $json.state, $json.actor_id, $json.actor_email, $json.actor_name] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "auditPostgres001",
          "name": "Audit log (Postgres)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000024",
      "name": "Replies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2800,
        -100
      ],
      "parameters": {
        "jsCode": "// S4 (Environment) and S5 (Ignore reason prompt), in the message's thread.\n// Only decisions just recorded get a reply (none twice).\nconst decisions = $('Decisions').all();\nreturn $input.all().flatMap((row, i) => {\n  if (!row.json.id) return [];\n  const d = decisions[i].json;\n  const base = { decision_id: row.json.id, kind: '', todo: '', todo_label: '', links: [], thread_ts: d.thread_ts || d.ts, action: d.action };\n  if (d.action === 'environment') {\n    return [{ json: { ...base, header: `Marked Environment by ${d.actor_name}`,\n      body: `<@${d.actor_id}> marked this failure 🌩️ Environment. The gate is unchanged. This will show in the daily update.`,\n      legend: '↩️ within 24 h to undo' } }];\n  }\n  return [{ json: { ...base, header: 'A reason is needed for 🙈 Ignore',\n    body: `<@${d.actor_id}>, to record 🙈 Ignore, reply in this thread with a short reason. Nothing is recorded until then.`, legend: '' } }];\n});\n"
      }
    },
