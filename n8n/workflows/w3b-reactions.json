      "name": "After posting",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3200,
        -100
      ],
      "parameters": {
        "jsCode": "// Slack didn't take a reply: fail (W0 alerts). Otherwise remember the prompt's\n// ts for 🙈, so the reason reply can be found.\nconst replies = $('Replies').all();\nconst posts = $input.all();\nconst failed = posts.filter((p) => !p.json.posted && !p.json.preview);\nif (failed.length) throw new Error(`reaction reply not posted: ${failed[0].json.error}`);\nreturn posts.map((p, i) => ({ json: { decision_id: replies[i].json.decision_id, action: replies[i].json.action, prompt_ts: p.json.ts ?? '' } }));\n"
      }
    },
