    {
      "id": "e3b2c3d4-0001-4000-8000-000000000004",
      "name": "Slack set up?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "e3b2c3d4-0001-4000-8000-000000000401",
              "leftValue": "={{ $json.slack_channel }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000005",
      "name": "Take the lock",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        600,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- One run at a time: take the lock unless another run took it in the last 5\n-- minutes (a run that died leaves it to expire).\nINSERT INTO audit.relay_state (name, value) VALUES ('w3b-lock', now()::text)\nON CONFLICT (name) DO UPDATE SET value = excluded.value, updated_at = now()\n  WHERE audit.relay_state.value::timestamptz < now() - interval '5 minutes'\nRETURNING value AS locked_at;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "auditPostgres001",
          "name": "Audit log (Postgres)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000006",
      "name": "Got the lock?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "e3b2c3d4-0001-4000-8000-000000000601",
              "leftValue": "={{ $json.locked_at ?? '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000007",
      "name": "Load messages",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Mapped messages up to 7 days old, each with its live (not undone) decision.\nSELECT coalesce(json_agg(json_build_object(\n         'map_id', m.id, 'channel', m.channel, 'ts', m.ts, 'kind', m.kind, 'test_id', m.test_id, 'ticket', m.ticket,\n         'nightly_run_id', m.nightly_run_id::text, 'class', m.class, 'thread_ts', m.thread_ts,\n         'source_run_id', m.source_run_id::text,\n         'decision', CASE WHEN d.id IS NULL THEN NULL ELSE json_build_object(\n           'id', d.id, 'action', d.action, 'state', d.state, 'actor_id', d.actor_id, 'actor_email', d.actor_email,\n           'actor_name', d.actor_name, 'prompt_ts', d.prompt_ts) END) ORDER BY m.id), '[]') AS messages\nFROM audit.message_map m\nLEFT JOIN audit.reaction_decisions d ON d.map_id = m.id AND d.undone_at IS NULL\nWHERE m.created_at > now() - interval '7 days';",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "auditPostgres001",
          "name": "Audit log (Postgres)"
        }
      }
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000008",
      "name": "QA group",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://slack.com/api/usergroups.users.list",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "usergroup",
              "value": "={{ $('Settings').first().json.qa_group_id }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "slackApi": {
          "id": "slackQaBot000001",
          "name": "QA Bot (Slack)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000009",
      "name": "QA members",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "jsCode": "// The QA group: the Slack user group's members (needs a paid Slack plan), or\n// the member IDs listed in Settings. Reactions from anyone else are ignored.\nconst settings = $('Settings').first().json;\nconst group = $input.first().json;\nconst fromGroup = group.ok && Array.isArray(group.users) ? group.users : [];\nconst fromList = String(settings.qa_member_ids || '').split(',').map((s) => s.trim()).filter(Boolean);\nreturn [{ json: { members: [...new Set([...fromGroup, ...fromList])] } }];\n"
      }
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000010",
      "name": "Waiting for a reason",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        -400
      ],
      "parameters": {
        "jsCode": "// 🙈 decisions waiting for their reason: look for the member's reply.\nconst list = (v) => (Array.isArray(v) ? v : JSON.parse(v || '[]'));\nreturn list($('Load messages').first().json.messages)\n  .filter((m) => m.decision && m.decision.state === 'waiting-for-reason' && m.decision.prompt_ts)\n  .map((m) => ({ json: { ...m, channel_id: m.channel, thread: m.thread_ts || m.ts } }));\n"
      }
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000011",
      "name": "Thread replies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        -400
      ],
      "parameters": {
        "method": "GET",
        "url": "https://slack.com/api/conversations.replies",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "channel",
              "value": "={{ $json.channel_id }}"
            },
            {
              "name": "ts",
              "value": "={{ $json.thread }}"
            },
            {
              "name": "oldest",
              "value": "={{ $json.decision.prompt_ts }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "slackApi": {
          "id": "slackQaBot000001",
          "name": "QA Bot (Slack)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000012",
      "name": "Reasons found",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        -400
      ],
      "parameters": {
        "jsCode": "// The member's first reply in the thread after the prompt is the reason.\nconst waiting = $('Waiting for a reason').all();\nreturn $input.all().flatMap((page, i) => {\n  const m = waiting[i].json;\n  const reply = (page.json.messages ?? []).find((r) => r.user === m.decision.actor_id && Number(r.ts) > Number(m.decision.prompt_ts)\n    && typeof r.text === 'string' && r.text.trim());\n  if (!reply) return [];\n  const reason = reply.text.trim().replace(/\\s+/g, ' ').slice(0, 300);\n  return [{ json: { ...m, reason, reply_ts: reply.ts } }];\n});\n"
      }
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000013",
      "name": "Record the reason",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2200,
        -400
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH saved AS (\n  UPDATE audit.reaction_decisions SET state = 'handled', reason = $2, handled_at = now()\n  WHERE id = $1::bigint AND state = 'waiting-for-reason'\n  RETURNING id\n)\nSELECT (SELECT id FROM saved) AS id;",
        "options": {
          "queryReplacement": "={{ [$json.decision.id, $json.reason] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "auditPostgres001",
          "name": "Audit log (Postgres)"
        }
      }
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000014",
      "name": "Ignore confirmation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        -400
      ],
      "parameters": {
        "jsCode": "// S4 for 🙈 once its reason is recorded.\nconst found = $('Reasons found').all();\nreturn $input.all().flatMap((row, i) => {\n  if (!row.json.id) return [];\n  const m = found[i].json;\n  return [{ json: { kind: '', header: `Ignored by ${m.decision.actor_name}`,\n    body: `<@${m.decision.actor_id}> marked this failure 🙈 Ignore. Reason: \"${m.reason}\". The gate is unchanged.`,\n    todo: '', todo_label: '', links: [], legend: '↩️ within 24 h to undo', thread_ts: m.thread },\n    pairedItem: i }];\n});\n"
      }
    },
