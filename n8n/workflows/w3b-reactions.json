        "jsCode": "// Audit with the member's email as the actor (FR-26).\nreturn $('Decisions').all().filter((d) => d.json.action === 'environment').map((d) => ({ json: {\n  actor: d.json.actor_email, actor_type: 'human', action: 'decision-environment',\n  target: d.json.test_id || d.json.ticket, link: d.json.nightly_run_id ? `https://github.com/${$('Settings').first().json.repo}/actions/runs/${d.json.nightly_run_id}` : '' } }));\n"
      },
      "executeOnce": true
