    {
      "id": "e3b2c3d4-0001-4000-8000-000000000016",
      "name": "Ignore audit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2800,
        -400
      ],
      "parameters": {
        "jsCode": "const failed = $input.all().filter((p) => !p.json.posted && !p.json.preview);\nif (failed.length) throw new Error(`ignore confirmation not posted: ${failed[0].json.error}`);\nreturn $('Reasons found').all().map((m) => ({ json: {\n  actor: m.json.decision.actor_email, actor_type: 'human', action: 'decision-ignore',\n  target: `${m.json.test_id || m.json.ticket}: ${m.json.reason}`.slice(0, 300), link: '' } }));\n"
      }
    },
    {
      "id": "e3b2c3d4-0001-4000-8000-000000000017",
      "name": "Write ignore audit",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        3000,
        -400
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "auditWriteEntry1",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "actor": "={{ $json.actor }}",
            "actor_type": "={{ $json.actor_type }}",
            "action": "={{ $json.action }}",
            "target": "={{ $json.target }}",
            "link": "={{ $json.link }}"
          },
          "matchingColumns": [],
          "schema": [
            {
