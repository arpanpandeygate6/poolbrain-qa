{
  "id": "ghReadArtifact01",
  "name": "GitHub: read artifact",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  },
  "nodes": [
    {
      "id": "a8b2c3d4-0001-4000-8000-000000000001",
      "name": "Artifact",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "repo",
              "type": "string"
            },
            {
              "name": "run_id",
              "type": "string"
            },
            {
              "name": "name",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "a8b2c3d4-0001-4000-8000-000000000002",
      "name": "List artifacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo }}/actions/runs/{{ $json.run_id }}/artifacts?name={{ encodeURIComponent($json.name) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubAppApi",
        "options": {}
      },
      "credentials": {
        "githubAppApi": {
          "id": "rtFV51PZnrrirWP0",
          "name": "qa-relay"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "a8b2c3d4-0001-4000-8000-000000000003",
      "name": "Has it?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// The newest unexpired artifact with that name, if any.\nconst a = ($input.first().json.artifacts ?? []).find((x) => x.name === $('Artifact').first().json.name && !x.expired);\nreturn [{ json: { url: a ? a.archive_download_url : '' } }];\n"
      }
    },
    {
      "id": "a8b2c3d4-0001-4000-8000-000000000004",
      "name": "Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a8b2c3d4-0001-4000-8000-000000000401",
              "leftValue": "={{ $json.url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a8b2c3d4-0001-4000-8000-000000000005",
      "name": "Get download link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubAppApi",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "githubAppApi": {
          "id": "rtFV51PZnrrirWP0",
          "name": "qa-relay"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "a8b2c3d4-0001-4000-8000-000000000006",
      "name": "Download",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -100
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.headers.location }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "a8b2c3d4-0001-4000-8000-000000000007",
      "name": "Unzip",
      "type": "n8n-nodes-base.compression",
      "typeVersion": 1.1,
      "position": [
        1320,
        -100
      ],
      "parameters": {
        "operation": "decompress",
        "binaryPropertyName": "data",
        "outputPrefix": "file_"
      }
    },
    {
      "id": "a8b2c3d4-0001-4000-8000-000000000008",
      "name": "Read JSON",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1540,
        -100
      ],
      "parameters": {
        "operation": "fromJson",
        "binaryPropertyName": "file_0",
        "options": {}
      }
    },
    {
      "id": "a8b2c3d4-0001-4000-8000-000000000009",
      "name": "Found",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -100
      ],
      "parameters": {
        "jsCode": "// The JSON file inside the artifact (artifacts here hold one JSON file).\nreturn [{ json: { found: true, data: $input.first().json.data } }];\n"
      }
    },
    {
      "id": "a8b2c3d4-0001-4000-8000-000000000010",
      "name": "Missing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "jsCode": "return [{ json: { found: false, data: null } }];\n"
      }
    }
  ],
  "connections": {
    "Artifact": {
      "main": [
        [
          {
            "node": "List artifacts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List artifacts": {
      "main": [
        [
          {
            "node": "Has it?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has it?": {
      "main": [
        [
          {
            "node": "Found?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Found?": {
      "main": [
        [
          {
            "node": "Get download link",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Missing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get download link": {
      "main": [
        [
          {
            "node": "Download",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download": {
      "main": [
        [
          {
            "node": "Unzip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unzip": {
      "main": [
        [
          {
            "node": "Read JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read JSON": {
      "main": [
        [
          {
            "node": "Found",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
