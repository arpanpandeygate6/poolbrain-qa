    {
      "id": "f1b2c3d4-0001-4000-8000-000000000004",
      "name": "Audit fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        0
      ],
      "parameters": {
        "jsCode": "// One audit entry per error, saying whether the alert reached Slack. If\n// Slack failed, W0 records that and stops: it never alerts about itself.\nconst r = $input.first().json;\nconst d = $('Describe the error').first().json;\nconst action = r.posted ? 'error-alert-posted' : r.preview ? 'error-alert-preview' : 'error-alert-failed';\nconst problem = typeof r.error === 'string' ? r.error : r.error?.message;\nreturn [{\n  json: {\n    actor: 'n8n:w0-error-handler',\n    actor_type: 'n8n',\n    action,\n    target: problem ? `${d.target}; ${String(problem).split('\\n')[0].slice(0, 160)}` : d.target,\n    link: d.link,\n  },\n}];\n"
      }
    },
