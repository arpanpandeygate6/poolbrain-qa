      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Turns n8n's error report into a short, safe S16 alert (EXPERIENCE.md M16).\n// Only the first line of the error is kept, cut to 160 characters, with\n// tokens, emails, long keys and URL query strings removed: no stack traces,\n// secrets or ticket text reach Slack (SEC-05).\n\nfunction clean(message) {\n  let t = String(message ?? 'no error message').split('\\n')[0];\n  t = t\n    .replace(/xox[a-z]-[\\w-]+/gi, '[hidden]')\n    .replace(/\\b(gh[pousr]_|github_pat_)\\w+/g, '[hidden]')\n    .replace(/\\b(bearer|token|basic)\\s+[\\w.~+\\/=-]+/gi, '$1 [hidden]')\n    .replace(/[\\w.+-]+@[\\w-]+(\\.[\\w-]+)+/g, '[email]')\n    .replace(/(https?:\\/\\/[^\\s?#]+)[?#]\\S*/g, '$1')\n    .replace(/\\b[\\w-]{32,}\\b/g, '[hidden]')\n    .trim();\n  if (t.length > 160) t = t.slice(0, 159) + '…';\n  return t.replace(/\\.$/, '');\n}\n\n// \"04 Oct 09:12 IST\"\nfunction ist(date) {\n  const parts = Object.fromEntries(\n    new Intl.DateTimeFormat('en-GB', {\n      timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23',\n    }).formatToParts(date).map((p) => [p.type, p.value]),\n  );\n  return `${parts.day} ${parts.month} ${parts.hour}:${parts.minute} IST`;\n}\n\nconst e = $input.first().json;\nconst execution = e.execution ?? {};\nconst error = execution.error ?? e.trigger?.error ?? {};\nconst workflow = e.workflow?.name ?? 'unknown workflow';\nconst step = execution.lastNodeExecuted ?? error.node?.name ?? 'trigger';\nconst url = execution.url ?? '';\n\nreturn [{\n  json: {\n    kind: 'alert',\n    header: `n8n workflow error in ${workflow}`,\n    body: `Step: ${step}. Error: ${clean(error.message)}.\\nTime: ${ist(new Date())}.`,\n    todo: 'n8n maintainer, open the execution (office network only).',\n    links: url ? [{ label: 'n8n execution', url }] : [],\n    target: `${workflow}, step ${step}`,\n    link: url,\n  },\n}];\n"
      }
    },
