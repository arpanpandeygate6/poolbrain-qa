          "convertFieldsToString": false
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "b9b2c3d4-0001-4000-8000-000000000013",
      "name": "Gate answers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        0
      ],
      "parameters": {
        "jsCode": "const requests = $('Requests to try').all();\nreturn $input.all().map((answer, i) => ({ json: { ...requests[i].json, allowed: answer.json.allowed === true } }));\n"
      }
