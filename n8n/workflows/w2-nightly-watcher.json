        2000,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/{{ $('Settings').first().json.repo }}/actions/workflows/triage.yml/dispatches",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubAppApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ref: 'main', inputs: { nightly_run_id: $json.target } }) }}",
        "options": {}
      },
      "credentials": {
        "githubAppApi": {
          "id": "rtFV51PZnrrirWP0",
          "name": "qa-relay"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "b9b2c3d4-0001-4000-8000-000000000016",
      "name": "Record started",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2200,
        -100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- At most one triage per nightly run. A started request leaves the waiting list.\nWITH saved AS (\n  INSERT INTO audit.triage_requests (nightly_run_id, state, dispatched_at)\n  VALUES ($1::bigint, $2, CASE WHEN $2 = 'dispatched' THEN now() END)\n  ON CONFLICT (nightly_run_id) DO UPDATE\n    SET state = excluded.state,\n        dispatched_at = CASE WHEN excluded.state = 'dispatched' THEN now() ELSE audit.triage_requests.dispatched_at END,\n        updated_at = now()\n  RETURNING nightly_run_id\n), dequeued AS (\n  UPDATE audit.deferred_requests SET done_at = now()\n  WHERE id = $3::bigint AND $2 = 'dispatched' AND done_at IS NULL\n  RETURNING id\n)\nSELECT (SELECT count(*) FROM saved) AS saved, (SELECT count(*) FROM dequeued) AS dequeued;",
        "options": {
          "queryReplacement": "={{ [$('Allowed?').item.json.target, 'dispatched', $('Allowed?').item.json.queue_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "auditPostgres001",
          "name": "Audit log (Postgres)"
        }
      }
    },
    {
      "id": "b9b2c3d4-0001-4000-8000-000000000017",
      "name": "Record kept back",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2000,
        100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- At most one triage per nightly run. A started request leaves the waiting list.\nWITH saved AS (\n  INSERT INTO audit.triage_requests (nightly_run_id, state, dispatched_at)\n  VALUES ($1::bigint, $2, CASE WHEN $2 = 'dispatched' THEN now() END)\n  ON CONFLICT (nightly_run_id) DO UPDATE\n    SET state = excluded.state,\n        dispatched_at = CASE WHEN excluded.state = 'dispatched' THEN now() ELSE audit.triage_requests.dispatched_at END,\n        updated_at = now()\n  RETURNING nightly_run_id\n), dequeued AS (\n  UPDATE audit.deferred_requests SET done_at = now()\n  WHERE id = $3::bigint AND $2 = 'dispatched' AND done_at IS NULL\n  RETURNING id\n)\nSELECT (SELECT count(*) FROM saved) AS saved, (SELECT count(*) FROM dequeued) AS dequeued;",
        "options": {
          "queryReplacement": "={{ [$json.target, 'deferred', $json.queue_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "auditPostgres001",
          "name": "Audit log (Postgres)"
        }
      }
    },
    {
      "id": "b9b2c3d4-0001-4000-8000-000000000018",
      "name": "Audit fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        -100
      ],
      "parameters": {
        "jsCode": "return $('Gate answers').all().filter((r) => r.json.allowed).map((r) => ({\n  json: {\n    actor: 'n8n:w2-nightly-watcher',\n    actor_type: 'n8n',\n    action: 'dispatch-triage',\n    target: `nightly ${r.json.target}`,\n    link: `https://github.com/${$('Settings').first().json.repo}/actions/runs/${r.json.target}`,\n  },\n}));\n"
      },
      "executeOnce": true
    },
