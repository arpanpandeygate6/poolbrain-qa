    {
      "id": "b9b2c3d4-0001-4000-8000-000000000005",
      "name": "Known requests",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        600,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT coalesce(json_agg(nightly_run_id::text), '[]') AS known FROM audit.triage_requests;",
        "options": {}
      },
