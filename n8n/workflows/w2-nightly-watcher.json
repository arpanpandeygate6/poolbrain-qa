        }
      }
    },
    {
      "id": "b9b2c3d4-0001-4000-8000-000000000006",
      "name": "Due queue",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        800,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Triage requests the gate kept back that may run now, in arrival order (Story 5.6).\nSELECT coalesce(json_agg(json_build_object('queue_id', id, 'nightly_run_id', target) ORDER BY created_at, id), '[]') AS due\nFROM audit.deferred_requests\nWHERE action = 'dispatch' AND workflow = 'triage' AND done_at IS NULL AND not_before <= now();",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "auditPostgres001",
          "name": "Audit log (Postgres)"
        }
      }
    },
    {
      "id": "b9b2c3d4-0001-4000-8000-000000000007",
      "name": "Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        -200
      ],
      "parameters": {
        "jsCode": "// Failed nightly runs of the last 36 hours that have no triage request yet.\nconst list = (v) => (Array.isArray(v) ? v : JSON.parse(v || '[]'));\nconst known = new Set(list($('Known requests').first().json.known));\nconst queued = new Set(list($('Due queue').first().json.due).map((d) => String(d.nightly_run_id)));\nconst runs = $('Failed nightlies').first().json.workflow_runs ?? [];\nreturn runs\n  .filter((r) => r.status === 'completed' && r.conclusion === 'failure')\n  .filter((r) => !known.has(String(r.id)) && !queued.has(String(r.id)))\n  .map((r) => ({ json: { nightly_run_id: String(r.id) } }));\n"
      }
    },
    {
      "id": "b9b2c3d4-0001-4000-8000-000000000008",
      "name": "List failure-list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -200
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Settings').first().json.repo }}/actions/runs/{{ $json.nightly_run_id }}/artifacts?name=failure-list",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubAppApi",
        "options": {}
      },
      "credentials": {
        "githubAppApi": {
          "id": "rtFV51PZnrrirWP0",
          "name": "qa-relay"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "b9b2c3d4-0001-4000-8000-000000000009",
      "name": "With failure-list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        -200
      ],
      "parameters": {
        "jsCode": "// Only nights whose report job saved a failure-list: it carries the Slack\n// thread W3 replies in (it exists only once Slack is set up, Story 2.4).\nconst candidates = $('Candidates').all();\nreturn $input.all().flatMap((page, i) =>\n  (page.json.artifacts ?? []).some((a) => a.name === 'failure-list' && !a.expired) ? [candidates[i]] : []);\n"
      }
    },
    {
      "id": "b9b2c3d4-0001-4000-8000-000000000010",
      "name": "Requests to try",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        100
      ],
      "parameters": {
        "jsCode": "// The waiting list first (oldest first), then newly failed nights.\n// triage_mode (Settings): only the exact value `agent` starts AI triage in\n// GitHub. Anything else is `plain`: new nights are recorded for W3's plain\n// \"Not classified\" messages and never go to the gate (no AI is used).\nconst list = (v) => (Array.isArray(v) ? v : JSON.parse(v || '[]'));\nconst plain = $('Settings').first().json?.triage_mode !== 'agent';\nconst due = plain ? [] : list($('Due queue').first().json.due).map((d) => ({ id: String(d.nightly_run_id), queue_id: d.queue_id }));\nconst fresh = $('With failure-list').isExecuted ? $('With failure-list').all().map((i) => ({ id: i.json.nightly_run_id, queue_id: 0 })) : [];\nreturn [...due, ...fresh]\n  .filter((r) => /^[1-9][0-9]*$/.test(r.id))\n  .map((r) => ({ json: { action: 'dispatch', workflow: 'triage', target: r.id, payload: { nightly_run_id: r.id }, queue_id: r.queue_id, plain } }));\n"
      },
      "alwaysOutputData": true
    },
    {
      "id": "b9b2c3d4-0001-4000-8000-000000000011",
      "name": "Anything to try?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b9b2c3d4-0001-4000-8000-000000001101",
              "leftValue": "={{ $json.target ?? '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b9b2c3d4-0001-4000-8000-000000000012",
      "name": "Gate",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "gateCheck0000001",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "action": "={{ $json.action }}",
            "workflow": "={{ $json.workflow }}",
            "target": "={{ $json.target }}",
            "payload": "={{ $json.payload }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "action",
              "displayName": "action",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string",
              "removed": false
            },
            {
              "id": "workflow",
              "displayName": "workflow",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
