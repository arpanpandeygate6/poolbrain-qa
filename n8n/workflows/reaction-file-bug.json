      "parameters": {
        "jsCode": "const v = $('Verify reporter').first().json;\nconst s = $('Settings').first().json;\nreturn [{ json: { jira_key: v.key, url: `${s.jira_url}/browse/${v.key}`, reporter_ok: v.reporter_ok } }];\n"
      }
    }
