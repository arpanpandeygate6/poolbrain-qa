    {
      "id": "f7b2c3d4-0001-4000-8000-000000000013",
      "name": "Verify reporter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ],
      "parameters": {
        "jsCode": "// Read the bug back: is the member its Reporter?\nconst res = $input.first().json;\nif (res.statusCode !== 200) throw new Error(`Jira didn't return the new bug (${res.statusCode})`);\nconst accountId = $('Build bug').first().json.account_id;\nreturn [{ json: { key: res.body.key, reporter_ok: Boolean(accountId) && res.body.fields?.reporter?.accountId === accountId } }];\n"
      }
    },
    {
      "id": "f7b2c3d4-0001-4000-8000-000000000014",
      "name": "Reporter set?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2600,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f7b2c3d4-0001-4000-8000-000000001401",
              "leftValue": "={{ $json.reporter_ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f7b2c3d4-0001-4000-8000-000000000015",
      "name": "Filed-by comment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2800,
        100
      ],
      "parameters": {
        "jsCode": "// S20: the Reporter couldn't be set, so a comment names who filed it.\n\n// Atlassian Document Format helpers: a paragraph of text and links.\nconst text = (t) => ({ type: 'text', text: t });\nconst linkTo = (label, url) => ({ type: 'text', text: label, marks: [{ type: 'link', attrs: { href: url } }] });\nconst para = (...parts) => ({ type: 'paragraph', content: parts.map((x) => (typeof x === 'string' ? text(x) : x)) });\nconst links = (items) => para(...items.filter((l) => l.url).flatMap((l, i) => (i ? [' · ', linkTo(l.label, l.url)] : [linkTo(l.label, l.url)])));\n\nconst r = $('Reaction').first().json;\nreturn [{ json: { body: { type: 'doc', version: 1, content: [\n  para(`Filed by ${r.actor_name} (${r.actor_email}) via Slack. Jira didn't accept them as Reporter. Filed via QA bot.`)] } } }];\n"
      }
    },
    {
      "id": "f7b2c3d4-0001-4000-8000-000000000016",
      "name": "Add the comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3000,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.jira_url }}/rest/api/3/issue/{{ $('Verify reporter').first().json.key }}/comment",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ body: $json.body }) }}"
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "3AkYlHarhuAfIA7s",
          "name": "Jira (QA relay)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "f7b2c3d4-0001-4000-8000-000000000017",
      "name": "Result",
      "type": "n8n-nodes-base.code",
