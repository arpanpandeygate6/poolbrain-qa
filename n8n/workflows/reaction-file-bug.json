    {
      "id": "f7b2c3d4-0001-4000-8000-000000000006",
      "name": "Build bug",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "jsCode": "// The S17 bug (EXPERIENCE.md M17): the drafted title (or the test ID when\n// unclassified), \"Filed via QA bot\", the run date, test and flow, and links.\n// Never the error text or any other raw evidence.\n\n// Atlassian Document Format helpers: a paragraph of text and links.\nconst text = (t) => ({ type: 'text', text: t });\nconst linkTo = (label, url) => ({ type: 'text', text: label, marks: [{ type: 'link', attrs: { href: url } }] });\nconst para = (...parts) => ({ type: 'paragraph', content: parts.map((x) => (typeof x === 'string' ? text(x) : x)) });\nconst links = (items) => para(...items.filter((l) => l.url).flatMap((l, i) => (i ? [' · ', linkTo(l.label, l.url)] : [linkTo(l.label, l.url)])));\n\nconst r = $('Reaction').first().json;\nconst s = $('Settings').first().json;\n// Jira hides most email addresses from search, so the QA lead can list the QA\n// team in Settings (account_map: {\"email\": \"Jira accountId\"}); search is the fallback.\nconst users = $('Jira user').first().json.body;\nlet listed = {};\ntry { listed = JSON.parse(s.account_map || '{}'); } catch { listed = {}; }\nconst accountId = listed[r.actor_email.toLowerCase()] || (Array.isArray(users) && users[0] ? users[0].accountId : '');\nconst run = $('Nightly run').first().json;\nconst started = run.statusCode === 200 ? run.body.run_started_at : '';\nconst day = started ? new Date(started).toLocaleString('en-US', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric' }) : 'unknown';\nconst runUrl = `https://github.com/${r.repo}/actions/runs/${r.nightly_run_id}`;\nconst thread = $('Slack link').first().json.permalink || '';\nconst summary = (r.bug_title || `Nightly failure: ${r.test_id}`).slice(0, 250);\nconst description = { type: 'doc', version: 1, content: [\n  para(`Filed via QA bot, by ${r.actor_name} from Slack.`),\n  para(`Nightly run: ${day}`),\n  para('Test: ', { type: 'text', text: r.test_id, marks: [{ type: 'code' }] }),\n  para(`Flow: ${r.flow_id || 'unknown'}`),\n  links([{ label: 'Nightly run', url: runUrl }, { label: 'Allure report', url: `${runUrl}#artifacts` }, { label: 'Slack thread', url: thread }]),\n] };\nconst fields = { project: { key: s.project }, issuetype: { name: s.issue_type }, summary, labels: [s.label], description };\nreturn [{ json: { account_id: accountId, with_reporter: accountId ? { ...fields, reporter: { id: accountId } } : fields, without_reporter: fields } }];\n"
      }
    },
    {
