    {
      "id": "f7b2c3d4-0001-4000-8000-000000000008",
      "name": "Created?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "jsCode": "// 201: created. A refused Reporter (no \"Modify Reporter\" permission) means\n// create again without it, then comment. Any other error fails the run (W0).\nconst res = $input.first().json;\nif (res.statusCode === 201) return [{ json: { key: res.body.key, retry: false } }];\nconst errors = JSON.stringify(res.body?.errors ?? {});\nif (res.statusCode === 400 && /reporter/i.test(errors)) return [{ json: { key: '', retry: true } }];\nthrow new Error(`Jira refused the bug (${res.statusCode}): ${errors.slice(0, 200)}`);\n"
      }
    },
    {
      "id": "f7b2c3d4-0001-4000-8000-000000000009",
      "name": "Reporter refused?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1600,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
