    {
      "id": "f7b2c3d4-0001-4000-8000-000000000011",
      "name": "Created again?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        -100
      ],
      "parameters": {
        "jsCode": "const res = $input.first().json;\nif (res.statusCode !== 201) throw new Error(`Jira refused the bug (${res.statusCode}): ${JSON.stringify(res.body?.errors ?? {}).slice(0, 200)}`);\nreturn [{ json: { key: res.body.key, retry: false } }];\n"
      }
    },
