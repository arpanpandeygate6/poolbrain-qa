    {
      "id": "a9b2c3d4-0001-4000-8000-000000000006",
      "name": "Build comment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "jsCode": "// S19 (EXPERIENCE.md M17): the approved questions, naming who approved them.\n\n// Atlassian Document Format helpers: a paragraph of text and links.\nconst text = (t) => ({ type: 'text', text: t });\nconst linkTo = (label, url) => ({ type: 'text', text: label, marks: [{ type: 'link', attrs: { href: url } }] });\nconst para = (...parts) => ({ type: 'paragraph', content: parts.map((x) => (typeof x === 'string' ? text(x) : x)) });\nconst links = (items) => para(...items.filter((l) => l.url).flatMap((l, i) => (i ? [' · ', linkTo(l.label, l.url)] : [linkTo(l.label, l.url)])));\n\nconst r = $('Reaction').first().json;\nconst [questions, outcome] = $('Read artifacts').all().map((i) => i.json);\nif (!questions.found) throw new Error(`draft-cases run ${r.source_run_id} has no questions file any more`);\nconst items = [...questions.data.questions].sort((a, b) => a.number - b.number);\nconst pr = outcome.found ? outcome.data.pr_url : '';\nconst thread = $('Slack link').first().json.permalink || '';\nreturn [{ json: { body: { type: 'doc', version: 1, content: [\n  para(`Clarification questions from QA, approved by ${r.actor_name} — Filed via QA bot`),\n  { type: 'orderedList', content: items.map((q) => ({ type: 'listItem', content: [para(q.question)] })) },\n  links([{ label: 'PR 1', url: pr }, { label: 'Slack thread', url: thread }]),\n] } } }];\n"
      }
    },
    {
      "id": "a9b2c3d4-0001-4000-8000-000000000007",
      "name": "Add the comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.jira_url }}/rest/api/3/issue/{{ $('Reaction').first().json.ticket }}/comment",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ body: $json.body }) }}"
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "3AkYlHarhuAfIA7s",
          "name": "Jira (QA relay)"
        }
      }
    },
    {
      "id": "a9b2c3d4-0001-4000-8000-000000000008",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "jsCode": "const res = $input.first().json;\nif (res.statusCode !== 201) throw new Error(`Jira refused the comment (${res.statusCode}): ${JSON.stringify(res.body?.errorMessages ?? res.body?.errors ?? {}).slice(0, 200)}`);\nconst r = $('Reaction').first().json;\nconst s = $('Settings').first().json;\nreturn [{ json: { jira_key: r.ticket, url: `${s.jira_url}/browse/${r.ticket}?focusedCommentId=${res.body.id}` } }];\n"
      }
    }
  ],
