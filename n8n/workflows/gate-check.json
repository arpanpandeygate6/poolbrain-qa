      "parameters": {
        "jsCode": "// The gate is open: the caller may act now.\nconst c = $('Check cap').isExecuted ? $('Check cap').first().json : {};\nreturn [{ json: { allowed: true, reason: 'ok', cap: c.cap ?? null, count: c.count ?? null } }];\n"
      }
    }
