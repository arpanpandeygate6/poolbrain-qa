    {
      "id": "b8b2c3d4-0001-4000-8000-000000000027",
      "name": "S11 message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3800,
        100
      ],
      "parameters": {
        "jsCode": "// S11 (EXPERIENCE.md M11): today's limit is reached, the request waits.\nconst WORK = {\n  'draft-cases': { work: 'case drafting', units: 'case drafts', later: (t) => `${t} will be drafted after 00:00 IST.`,\n    urgent: 'run /draft-cases in Claude Code on a laptop, or ask the QA lead to change the limit.' },\n  'generate-tests': { work: 'test generation', units: 'test generations',\n    later: (t) => `Tests for ${t} will be generated after 00:00 IST.`,\n    urgent: 'run /generate-api-tests in Claude Code on a laptop, or ask the QA lead to change the limit.' },\n  triage: { work: 'triage', units: 'triage runs', later: () => 'Triage runs again after 00:00 IST.',\n    urgent: 'triage the failures by hand from the failure list, or ask the QA lead to change the limit.' },\n  quarantine: { work: 'quarantine requests', units: 'quarantine requests',\n    later: (t) => `The quarantine request for ${t} will be made after 00:00 IST.`,\n    urgent: 'open the quarantine PR by hand, or ask the QA lead to change the limit.' },\n};\nconst d = $input.first().json;\nconst g = $('Gate input').first().json;\nconst w = WORK[g.workflow] ?? { work: g.workflow, units: `${g.workflow} runs`,\n  later: (t) => `${t || 'The request'} runs after 00:00 IST.`, urgent: 'ask the QA lead to change the limit.' };\nreturn [{\n  json: {\n    kind: 'info',\n    header: `${w.work.charAt(0).toUpperCase()}${w.work.slice(1)} waits until tomorrow`,\n    body: `Today's limit of ${d.cap} ${w.units} is reached (counted since 00:00 IST).\\n${w.later(g.target)}`,\n    todo: w.urgent,\n    todo_label: 'If urgent',\n    links: [],\n    thread_ts: '',\n  },\n}];\n"
      }
    },
