      "name": "Deferred",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3400,
        200
      ],
      "parameters": {
        "jsCode": "// Which path deferred the request: AI work off, or the daily cap.\nconst d = $('Disabled').isExecuted ? $('Disabled').first().json : $('Check cap').first().json;\nconst state = $('Read state').first().json;\n// S11 goes out once per workflow per IST day, not once per request.\nconst s11 = d.reason === 'capped' && state.s11_sent_on !== d.today;\nreturn [{ json: { ...d, queued_id: Number($input.first().json.id), s11 } }];\n"
      }
    },
