      "id": "b8b2c3d4-0001-4000-8000-000000000005",
      "name": "Switch state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "jsCode": "// The kill switch (FR-24): only the exact value `true` lets AI work run. Any\n// other value, a missing variable or a failed read counts as off. A change\n// since the last check produces one S12 notice (UX-DR20).\nconst read = $('Read AGENT_ENABLED').first().json;\nconst enabled = read.value === 'true';\nconst last = $('Read state').first().json.last_enabled ?? 'true';\nconst transition = enabled && last === 'false' ? 'on' : !enabled && last === 'true' ? 'off' : '';\n\nconst notice = transition === 'off'\n  ? {\n    kind: 'alert',\n    header: 'AI work is off',\n    body: '`AGENT_ENABLED` is not `true`. The agent will not draft, generate, triage, quarantine or write to Jira.\\n'\n      + 'Still running: nightly and smoke tests, the failure list, heartbeat, error alerts, audit.',\n    todo: 'QA lead or n8n maintainer sets `AGENT_ENABLED` to `true`.',\n    todo_label: 'To turn it back on',\n  }\n  : { kind: 'info', header: 'AI work is on again', body: '`AGENT_ENABLED` is `true`.', todo: '', todo_label: '' };\n\nreturn [{ json: { enabled, transition, ...notice, links: [], thread_ts: '' } }];\n"
      }
    },
