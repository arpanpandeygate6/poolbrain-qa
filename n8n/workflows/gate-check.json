      "parameters": {
        "jsCode": "// The notice must go out (or be previewed) before the new state is saved, so\n// a failed post is tried again on the next gated action.\nconst r = $input.first().json;\nconst s = $('Switch state').first().json;\nif (!r.posted && !r.preview) throw new Error(`S12 notice not posted: ${r.error}`);\nreturn [{\n  json: {\n    actor: 'n8n:gate-check',\n    actor_type: 'n8n',\n    action: s.enabled ? 'ai-work-on-notice' : 'ai-work-off-notice',\n    target: 'AGENT_ENABLED',\n    link: r.link || '',\n  },\n}];\n"
