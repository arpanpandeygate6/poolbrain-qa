    {
      "id": "b8b2c3d4-0001-4000-8000-000000000016",
      "name": "Completed runs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2800,
        -400
      ],
      "parameters": {
        "jsCode": "// Completed runs since 00:00 IST may have a run-outcome that excludes them\n// from the count (capped, disabled, blocked); fetch only those outcomes.\n\n// The start of today in IST (00:00 IST = 18:30 UTC the day before), as a Date.\nfunction istMidnight(now) {\n  const ist = new Date(now.getTime() + 330 * 60000);\n  return new Date(Date.UTC(ist.getUTCFullYear(), ist.getUTCMonth(), ist.getUTCDate()) - 330 * 60000);\n}\nconst istDay = (now) => new Date(now.getTime() + 330 * 60000).toISOString().slice(0, 10);\n\nconst since = istMidnight(new Date());\nconst runs = $(\"Today's runs\").first().json.workflow_runs;\nreturn (Array.isArray(runs) ? runs : [])\n  .filter((r) => r.status === 'completed' && new Date(r.created_at) >= since)\n  .map((r) => ({ json: { run_id: r.id } }));\n"
      }
    },
    {
      "id": "b8b2c3d4-0001-4000-8000-000000000017",
      "name": "List outcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3000,
        -400
