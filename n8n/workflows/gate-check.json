      "name": "Defer request",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        3200,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Keep the request. Asking again for the same open request only updates its\n-- reason and time; its place in the queue (created_at) stays.\nINSERT INTO audit.deferred_requests (action, workflow, target, payload, reason, not_before)\nVALUES ($1, $2, $3, $4::jsonb, $5, $6::timestamptz)\nON CONFLICT (action, workflow, target) WHERE done_at IS NULL\nDO UPDATE SET reason = excluded.reason, not_before = excluded.not_before, payload = excluded.payload\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [$('Gate input').first().json.action, $('Gate input').first().json.workflow || '', $('Gate input').first().json.target || '', JSON.stringify($('Gate input').first().json.payload ?? {}), $json.reason, $json.not_before] }}"
        }
      },
