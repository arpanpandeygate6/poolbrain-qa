      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Settings').first().json.repo }}/actions/workflows/{{ $('Gate input').first().json.workflow }}.yml/runs?per_page=100&created=%3E%3D{{ new Date(Date.now() - 36 * 3600000).toISOString().slice(0, 19) }}Z",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubAppApi",
