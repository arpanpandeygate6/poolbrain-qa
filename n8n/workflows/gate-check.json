    {
      "id": "b8b2c3d4-0001-4000-8000-000000000022",
      "name": "Check cap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2800,
        -100
      ],
      "parameters": {
        "jsCode": "// The daily cap (FR-25, AR-11). The counting rule is shared with the agent's\n// own first step and tested against contracts/cap-count.fixture.json.\n\n// The start of today in IST (00:00 IST = 18:30 UTC the day before), as a Date.\nfunction istMidnight(now) {\n  const ist = new Date(now.getTime() + 330 * 60000);\n  return new Date(Date.UTC(ist.getUTCFullYear(), ist.getUTCMonth(), ist.getUTCDate()) - 330 * 60000);\n}\nconst istDay = (now) => new Date(now.getTime() + 330 * 60000).toISOString().slice(0, 10);\n\nconst EXCLUDED = new Set(['capped', 'disabled', 'blocked']);\n\nfunction countToday(runs, now, currentRunId) {\n  const since = istMidnight(now);\n  return runs.filter((r) => new Date(r.created_at) >= since && r.id !== currentRunId && !EXCLUDED.has(r.outcome)).length;\n}\n\nconst workflow = $('Gate input').first().json.workflow;\nconst now = new Date();\n\n// Outcomes read from the run-outcome artifacts, by run ID.\nconst outcomes = {};\nif ($('Read outcome').isExecuted) {\n  for (const item of $('Read outcome').all()) {\n    const o = item.json.data;\n    if (o && o.run_id) outcomes[o.run_id] = o.status;\n  }\n}\nconst listed = $(\"Today's runs\").first().json.workflow_runs;\nconst runs = (Array.isArray(listed) ? listed : [])\n  .map((r) => ({ id: r.id, created_at: r.created_at, status: r.status, outcome: outcomes[r.id] ?? null }));\n\n// A missing, unreadable or incomplete AGENT_CAPS counts as \"cap reached\".\nlet cap;\nlet problem = '';\ntry {\n  const caps = JSON.parse($('Read AGENT_CAPS').first().json.value ?? '');\n  cap = caps?.[workflow];\n  if (!Number.isInteger(cap) || cap < 0) problem = `AGENT_CAPS has no daily limit for ${workflow}`;\n} catch {\n  problem = 'AGENT_CAPS is missing or not valid JSON';\n}\n\nconst count = countToday(runs, now, null);\nconst tomorrow = new Date(istMidnight(now).getTime() + 24 * 3600000).toISOString();\nif (problem) {\n  return [{ json: { decision: 'caps-invalid', reason: 'caps-invalid', problem, count, not_before: tomorrow,\n    audit_action: 'gate-deferred-caps-invalid' } }];\n}\nif (count >= cap) {\n  return [{ json: { decision: 'capped', reason: 'capped', cap, count, today: istDay(now), not_before: tomorrow,\n    audit_action: 'gate-deferred-capped' } }];\n}\nreturn [{ json: { decision: 'ok', cap, count } }];\n"
      }
    },
    {
      "id": "b8b2c3d4-0001-4000-8000-000000000023",
      "name": "Over cap?",
