      "typeVersion": 2,
      "position": [
        4800,
        200
      ],
      "parameters": {
        "jsCode": "// Tell the caller not to act. A broken AGENT_CAPS also fails the caller's\n// run, so W0 alerts with the reason; the request is already kept.\nconst d = $('Deferred').first().json;\nif (d.reason === 'caps-invalid') {\n  throw new Error(`${d.problem}. Request kept until it is fixed (deferred request ${d.queued_id}).`);\n}\nreturn [{ json: { allowed: false, reason: d.reason, queued_id: d.queued_id, not_before: d.not_before,\n  cap: d.cap ?? null, count: d.count ?? null } }];\n"
      }
    },
