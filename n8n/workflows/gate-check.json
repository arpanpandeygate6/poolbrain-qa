      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Settings').first().json.repo }}/actions/runs/{{ $json.run_id }}/artifacts?name=run-outcome",
        "authentication": "predefinedCredentialType",
