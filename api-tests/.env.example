# Copy to .env.uat and fill in. This file is gitignored.
# Only UAT runs locally. Preprod, PROD and NPP credentials exist only as
# CI secrets and must never be stored on a laptop (PRD FR-03).

API_BASE_URL=
API_TOKEN=

# UAT read-replica SQL access (read-only user)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
