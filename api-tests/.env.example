# Copy to .env.uat and fill in. This file is gitignored.
# Only UAT runs locally. Preprod, PROD and NPP credentials exist only as
# CI secrets and must never be stored on a laptop (PRD FR-03).

# Pretend PoolBrain (mock-poolbrain/): http://127.0.0.1:5050/api
API_BASE_URL=
API_TOKEN=

# Role test account for the API login test (OTP bypassed on UAT only).
# With the pretend site, choose any email and password: it accepts these.
API_USER_EMAIL=
API_USER_PASSWORD=

# UAT read-replica SQL access (read-only user).
# Pretend PoolBrain: DB_HOST=127.0.0.1, DB_PORT=3307, DB_NAME=poolbrain,
# DB_USER=qa_readonly and any DB_PASSWORD you choose (it creates that user).
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Smoke tests (Story 3.1): the testing company's ID, which every smoke test checks
# the data it reads belongs to. Required on Preprod, PROD and NPP (CI secrets);
# optional on UAT and the pretend PoolBrain, where the check is skipped when empty.
TESTING_COMPANY_ID=
